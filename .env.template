# GEE Credentials
GEE_PROJECT=your-gee-project
GEE_BUCKET=your-gee-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-file.json

# AWS Credentials
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=your-aws-region
AWS_S3_BUCKET=your-aws-s3-bucket-name
AWS_S3_PREFIX=methanesat_l4

# Local Storage
LOCAL_DATA_DIR=./data
LIMIT=5  # Optional: Limit number of files for testing
SKIP_INGESTION=false  # Set to true to skip STAC/DB ingestion (dry run)

# GEE Product Prefixes
# Comma-separated list of prefixes to scan and match
# Example: core/t100/, divergence_integral/t100/
GEE_PREFIX=core/, divergence_integral/

# STAC Settings
STAC_COLLECTION_ID=my-gee-data-collection
STAC_COLLECTION_TITLE="GEE Data Collection"
STAC_COLLECTION_DESCRIPTION="Data ingested from GEE bucket"
STAC_STYLE_URL=https://raw.githubusercontent.com/eurodatacube/eodash-assets/main/collections/methanesat_l4/style.json

# eoapi Database Credentials
# pypgstac uses PGHOST, PGPORT, etc. or a connection string
PGHOST=your-db-host
PGPORT=5432
PGDATABASE=your-db-name
PGUSER=your-db-user
PGPASSWORD=your-db-password
