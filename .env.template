# GEE Credentials
GEE_PROJECT=your-gee-project
GEE_BUCKET=your-gee-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-file.json

# AWS Credentials
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=your-aws-region
AWS_S3_BUCKET=your-aws-s3-bucket-name
AWS_S3_PREFIX=methanesat_l4

# Local Storage
LOCAL_DATA_DIR=./data
LIMIT=5  # Optional: Limit number of files for testing
SKIP_INGESTION=false  # Set to true to skip STAC/DB ingestion (dry run)
INGESTION_ONLY=false  # Set to true to read items from S3 and ingest (bypass GEE)
SKIP_DOWNLOAD=false   # Set to true to skip downloading files if they already exist locally
SKIP_UPLOAD=false     # Set to true to skip uploading files if they already exist in S3


# GEE Product Prefixes
# Comma-separated list of prefixes to scan and match
# Example: core/t100/, divergence_integral/t100/
GEE_PREFIX=core/, divergence_integral/

# STAC Settings
STAC_COLLECTION_ID=my-gee-data-collection
STAC_COLLECTION_TITLE="GEE Data Collection"
STAC_COLLECTION_DESCRIPTION="Data ingested from GEE bucket"
STAC_STYLE_URL=https://raw.githubusercontent.com/eurodatacube/eodash-assets/main/collections/methanesat_l4/style.json
STAC_PUBLIC_URL_PREFIX=https://domain.at/api/public/share/id/
STAC_REMOTE_ENDPOINT="https://portal.methanesat.org/stac/search?limit=1000&collections=MethaneSAT_Level4_Portal%2CMethaneSAT_Level4_Portal_twostep%2CMethaneSAT_Level4_point_pruned&fields=properties%2Ccollection%2Clinks%2Cgeometry%2Cassets%2C-properties.proj%3Aepsg%2C-properties.proj%3Awkt2%2C-properties.proj%3Atransform%2C-properties.proj%3Abbox%2C-properties.proj%3Ashape%2C-links&sortby=-properties.end_datetime"

# eoapi Database Credentials
# pypgstac uses PGHOST, PGPORT, etc. or a connection string
PGHOST=your-db-host
PGPORT=5432
PGDATABASE=your-db-name
PGUSER=your-db-user
PGPASSWORD=your-db-password
